# Receptor structures are .pdb files in proteins/ and ARE tracked.
*.pdbqt
*.gpf
*.dpf
AD4_metals.dat

# Scratch result files. To publish results, put them in a results/ folder.
test.csv
/results*.csv

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
